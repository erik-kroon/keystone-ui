{
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "rootDirs": ["."],
    "paths": {
      "@/*": ["./src/*"],
      "@keystone-ui/ui/blocks/*": ["../../packages/ui/src/blocks/*"],
      "@keystone-ui/ui/components/*": ["../../packages/ui/src/components/*"],
      "@keystone-ui/ui/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@keystone-ui/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "@keystone-ui/ui/stores/*": ["../../packages/ui/src/stores/*"],
      "@keystone-ui/ui/templates/*": ["../../packages/ui/src/templates/*"],
      "@keystone-ui/ui/*": ["../../packages/ui/src/components/*"]
    }
  }
}
