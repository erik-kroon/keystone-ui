{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run generate:registry-items && bun run generate:shadcn-registry && vite build",
    "deploy": "bun run build && bunx --bun wrangler@4 deploy",
    "deploy:production": "bun run deploy",
    "deploy:production:dry-run": "bun run build && bunx --bun wrangler@4 deploy --dry-run",
    "generate:registry-items": "bun ../../scripts/generate-docs-registry-items.ts",
    "generate:shadcn-registry": "bun ../../scripts/generate-shadcn-registry.ts",
    "serve": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "bun test --pass-with-no-tests",
    "dev:bare": "vite dev"
  },
  "dependencies": {
    "@keystone-ui/core": "workspace:*",
    "@keystone-ui/ui": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/solid-form": "^1.29.1",
    "@tanstack/solid-router": "^1.168.20",
    "@tanstack/solid-router-devtools": "^1.166.13",
    "@tanstack/solid-start": "^1.167.58",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.8.0",
    "shiki": "^4.0.2",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "catalog:",
    "vite": "^8.0.8",
    "vite-plugin-solid": "^2.11.12"
  }
}
