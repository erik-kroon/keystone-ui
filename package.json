{
  "name": "keystone-ui",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "alchemy": "^0.91.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test:keystone": "turbo -F @keystone-ui/keystone test",
    "test:mason-cli": "bun --filter @keystone-ui/mason-cli test",
    "test:mason-registry": "bun --filter @keystone-ui/mason-registry test",
    "verify:release": "bun run check && bun run check-types && bun run test:keystone && bun run test:mason-cli && bun run test:mason-registry && bun run build",
    "dev:web": "turbo -F web dev",
    "deploy": "turbo -F @keystone-ui/infra deploy",
    "destroy": "turbo -F @keystone-ui/infra destroy",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@keystone-ui/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@keystone-ui/config": "workspace:*",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.9"
}
