{
  "name": "keystone-ui",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.1.13",
      "typescript": "^6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy": "bun run --cwd apps/web deploy",
    "check-types": "turbo check-types",
    "test:core": "turbo -F @keystone-ui/core test",
    "test:docs": "bun --filter web test --pass-with-no-tests",
    "test:mason": "bun --filter @keystone-ui/mason test",
    "verify:example-app": "bun scripts/verify-example-app.ts",
    "verify:release": "bun run check && bun run check-types && bun run test:core && bun run test:docs && bun run test:mason && bun run verify:example-app && bun run build",
    "dev:docs": "turbo -F web dev",
    "check": "oxlint && oxfmt --write"
  },
  "devDependencies": {
    "@tanstack/solid-hotkeys": "^0.10.0",
    "@tanstack/solid-store": "^0.11.0",
    "@tanstack/solid-table": "^8.21.3",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.9"
}
