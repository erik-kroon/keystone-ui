{
  "name": "solid-themes",
  "version": "0.0.0",
  "description": "Theme runtime and Solid bindings for Vite, SolidStart, and TanStack Start.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./solid-start": {
      "types": "./dist/adapters/solid-start.d.ts",
      "import": "./dist/adapters/solid-start.js"
    },
    "./tanstack-start": {
      "types": "./dist/adapters/tanstack-start.d.ts",
      "import": "./dist/adapters/tanstack-start.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rolldown -c --clean-dir && tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@types/node": "^22.0.0",
    "jsdom": "^24.1.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "rolldown": "^1.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0 || ^1.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
